PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campusflow
JWT_SECRET=change-me

# Email (optional — Phase 2). Leave blank to skip email; in-app notifications still work.
SMTP_HOST=          # e.g. smtp.gmail.com
SMTP_PORT=587       # 587 for STARTTLS, 465 for SSL
SMTP_USER=          # your mailbox address
SMTP_PASS=          # app password, not your login password
SMTP_FROM=          # shown as the sender; defaults to SMTP_USER
APP_URL=http://localhost:5173   # links in emails point back to the app

# Lab agent (Phase 2, M3). The C++ lab agent sends its key in the
# X-Agent-Key header when it reports machine status. The default
# 'dev-agent-key' is for local development only — set a long random key
# on any shared or deployed server.
LAB_AGENT_KEY=dev-agent-key
